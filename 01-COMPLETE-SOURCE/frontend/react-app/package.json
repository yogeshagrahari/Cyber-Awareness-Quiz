{
  "name": "cyberaware-3d-react",
  "version": "0.10.0-rc.16",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.5"
  },
  "scripts": {
    "dev": "npm run sync:assets && vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run sync:assets && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test:domain": "node --experimental-strip-types --test tests/*.test.ts",
    "sync:assets": "node ../scripts/sync-react-assets.mjs",
    "test": "npm run test:domain",
    "smoke:build": "node ../scripts/smoke-react-build.mjs",
    "test:e2e": "playwright test",
    "verify:lockfile": "node scripts/verify-lockfile.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "@types/node": "26.6.6",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0"
  },
  "packageManager": "npm@12.2.2"
}
